# 可选：部署版本标识（未设置时优先读取 Railway/Zeabur 的提交 SHA）
APP_VERSION=

# Coze API 配置
COZE_API_KEY=your_coze_api_key_here
COZE_CHAT_API_VERSION=v3
COZE_V3_CHAT_URL=https://api.coze.cn/v3/chat
# 临时排查时开启，日志仅输出请求元信息及事件摘要，不含密钥或完整历史
COZE_DIAGNOSTICS_ENABLED=false

# 上下文：同一用户在各智能体间共享最近 6 轮，清空对话后遗忘
CHAT_CONTEXT_ROUNDS=6
CHAT_CONTEXT_MESSAGE_MAX_CHARS=2000
# 下列传递模式仅用于回退 v2；v3 始终通过 additional_messages 传递完整历史问答
# query：仅历史问题写入本次输入，不携带旧回答
# history：通过 Coze v2 chat_history 字段传递（需 Coze 编排向下游传递历史）
CHAT_CONTEXT_DELIVERY=query
# 单次聊天总时限（秒），必须小于 nginx proxy_read_timeout 和 gunicorn --timeout
CHAT_TOTAL_TIMEOUT_SECONDS=150
# 等待 Coze 时发送 SSE 心跳的间隔（秒）
CHAT_STREAM_HEARTBEAT_SECONDS=15
# 空召回时，首次 Coze 调用超过该秒数则跳过改写重查（0 表示不跳过）
CHAT_REWRITE_MAX_INITIAL_SECONDS=30

# 机器人 ID（可选，默认使用配置中的 ID）
BOT_PRODUCT=7595022659508125738
BOT_FAQ=7595022659508125738
BOT_MOMENT=7594631042351644715
BOT_SCRIPT=7630704938662363162

# 安全密钥
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# 只读 MCP 端点（POST /api/mcp）的 Bearer token；留空则端点整体关闭。
# 生成示例：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# 生产部署建议
DATABASE_DIR=/data
UPLOAD_DIR=/data/uploads
TRUST_PROXY=true
# 多个来源用逗号分隔；同源部署可留空
CORS_ORIGINS=
# 默认关闭公开注册；管理员请运行 scripts/create_admin.py
PUBLIC_REGISTRATION_ENABLED=false
# 每个 Gunicorn worker 最多同时处理的流式聊天数；
# 全局并发上限 = 本值 × gunicorn workers，请据此评估 Coze 配额
CHAT_STREAM_MAX_CONCURRENT_PER_WORKER=3
CHAT_QUEUE_MAX_SIZE=10
CHAT_QUEUE_TTL_SECONDS=300
CHAT_QUEUE_POLL_INTERVAL_SECONDS=2

# 人工转接对账后台线程周期（秒）
HANDOFF_RECONCILE_INTERVAL_SECONDS=5

# 前台历史可见期限与启动清理（默认关闭；清理仅隐藏前台历史，后台记录和统计保留）
CLEANUP_ON_STARTUP=false
CHAT_RETENTION_DAYS=30

# 功能开关默认值（运行时以数据库 settings 为准，后台「功能开关」页可改）
CASES_ENABLED=true
AUDIO_COURSES_ENABLED=false
HANDOFF_ENABLED=false
PRACTICE_ENABLED=false

# 音频课程上传（字节）；同时需保证全局 MAX_CONTENT_LENGTH 不小于该值
AUDIO_MAX_UPLOAD_BYTES=52428800
MAX_CONTENT_LENGTH=54525952
