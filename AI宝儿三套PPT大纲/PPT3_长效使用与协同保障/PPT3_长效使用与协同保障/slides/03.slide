        <Box style={{ width: 56, height: 4, borderRadius: 2, background: '#1F7A5C', marginTop: 8 }} />
    </Box>

    <Box style={{ height: 528 }}>
        <Box style={{ height: 290, background: '#FFFFFF', borderRadius: 14, padding: 16, boxShadow: '0 4px 20px rgba(30,58,50,0.08)' }}>
            <svg width="1104" height="258" viewBox="0 0 1104 258">
                <rect x="14" y="24" width="400" height="210" rx="16" fill="#F7FAF6" />
