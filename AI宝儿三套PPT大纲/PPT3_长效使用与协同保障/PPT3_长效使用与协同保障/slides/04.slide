<Slide style={{
    background: '#F7FAF6',
    paddingTop: 20, paddingBottom: 20, paddingLeft: 72, paddingRight: 72,
}}>
    <Box style={{ height: 100, justifyContent: 'center' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E3A32' }}>社区问答的审核与安全</Text>
        <Box style={{ width: 56, height: 4, borderRadius: 2, background: '#1F7A5C', marginTop: 8 }} />
    </Box>

    <Box style={{ height: 528, flexDirection: 'row', gap: 28 }}>
        <Box style={{ flex: 1, height: 528 }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1F7A5C', lineHeight: 1.4 }}>
                匿名 + 先审后公开，既保护你也保护大家
            </Text>
            <Box style={{ marginTop: 18, gap: 16 }}>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <FAIcon name='user-secret' style={{ fill: '#1F7A5C', width: 26, height: 26 }} />
                    <Box>
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E3A32' }}>回复默认匿名</Text>
                        <Text style={{ fontSize: 19, color: '#6B7C75', lineHeight: 1.5 }}>不暴露你是谁，放心参与讨论。</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <FAIcon name='eye-slash' style={{ fill: '#1F7A5C', width: 26, height: 26 }} />
                    <Box>
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E3A32' }}>先审后公开</Text>
                        <Text style={{ fontSize: 19, color: '#6B7C75', lineHeight: 1.5 }}>新回复审核中，只有你自己看得见。</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <FAIcon name='filter' style={{ fill: '#1F7A5C', width: 26, height: 26 }} />
                    <Box>
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E3A32' }}>屏蔽词机制</Text>
                        <Text style={{ fontSize: 19, color: '#6B7C75', lineHeight: 1.5 }}>过滤不当内容，社区环境更干净。</Text>
                    </Box>
                </Box>
            </Box>
            <Box style={{ marginTop: 22, background: 'rgba(31,122,92,0.06)', borderRadius: 14, padding: 18 }}>
                <Text style={{ fontSize: 19, color: '#1E3A32', lineHeight: 1.55 }}>
                    规则不是来管你的，是让你敢于提问、敢于分享——匿名与先审，把「说错话」的顾虑降到最低。
                </Text>
            </Box>
        </Box>

        <Box style={{ width: 520, height: 528, background: '#FFFFFF', borderRadius: 14, padding: 22, boxShadow: '0 4px 20px rgba(30,58,50,0.08)' }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E3A32' }}>一条回复的去向</Text>
            <svg width="476" height="440" viewBox="0 0 476 440" style={{ marginTop: 10 }}>
                <rect x="40" y="40" width="150" height="56" rx="14" fill="#1F7A5C" />
                <text x="115" y="74" textAnchor="middle" fontSize="21" fill="#FFFFFF" fontFamily="PingFang SC">提交回复</text>

                <line x1="190" y1="68" x2="240" y2="68" stroke="#A8D5BA" strokeWidth="3" />
                <path d="M240 68 l-10 -6 l0 12 z" fill="#A8D5BA" />

                <rect x="250" y="40" width="186" height="56" rx="14" fill="#E08A3C" />
                <text x="343" y="74" textAnchor="middle" fontSize="21" fill="#FFFFFF" fontFamily="PingFang SC">待审（仅自己可见）</text>

                <line x1="343" y1="96" x2="343" y2="160" stroke="#A8D5BA" strokeWidth="3" />
                <path d="M343 160 l-6 -10 l12 0 z" fill="#A8D5BA" />

                <rect x="250" y="170" width="186" height="56" rx="14" fill="#1F7A5C" />
                <text x="343" y="204" textAnchor="middle" fontSize="21" fill="#FFFFFF" fontFamily="PingFang SC">审核通过 · 公开</text>

                <rect x="200" y="320" width="240" height="56" rx="14" fill="rgba(168,213,186,0.45)" />
                <text x="320" y="354" textAnchor="middle" fontSize="20" fill="#1E3A32" fontFamily="PingFang SC">未过审 · 隐藏/不公开</text>

                <line x1="343" y1="226" x2="343" y2="300" stroke="#A8D5BA" strokeWidth="3" strokeDasharray="6 5" />
                <path d="M343 300 l-6 -10 l12 0 z" fill="#A8D5BA" />
                <line x1="343" y1="300" x2="320" y2="320" stroke="#A8D5BA" strokeWidth="3" strokeDasharray="6 5" />

                <text x="90" y="300" fontSize="16" fill="#6B7C75" fontFamily="PingFang SC">通过</text>
                <text x="408" y="300" fontSize="16" fill="#6B7C75" fontFamily="PingFang SC">未过</text>
            </svg>
        </Box>
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <svg width="20" height="20" viewBox="0 0 24 24">
                <path d="M12 21C12 21 4 17 4 10C4 6 7 3 12 3C17 3 20 6 20 10C20 17 12 21 12 21Z" fill="#1F7A5C" opacity="0.75" />
                <path d="M12 21V6" stroke="#FFFFFF" strokeWidth="1.6" fill="none" />
            </svg>
            <Text style={{ fontSize: 14, color: '#6B7C75' }}>AI宝儿 · 长效使用与协同保障</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#6B7C75' }}>04 / 9</Text>
    </Box>
</Slide>
