    <Box style={{ width: '100%', height: '100%', alignItems: 'center', justifyContent: 'center', paddingLeft: 72, paddingRight: 72 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 46, height: 46, borderRadius: 23, background: '#1F7A5C', justifyContent: 'center', alignItems: 'center' }}>
                <svg width="26" height="26" viewBox="0 0 24 24">
