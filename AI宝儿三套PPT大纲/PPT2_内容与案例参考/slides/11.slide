                <rect x="44" y="296" width="140" height="48" rx="12" fill="rgba(31,122,92,0.1)" />
                <rect x="44" y="352" width="140" height="24" rx="12" fill="#E08A3C" opacity="0.85" />

                <path d="M222 226 L280 226" stroke="#A8D5BA" strokeWidth="5" strokeLinecap="round" />
                <path d="M268 214 L286 226 L268 238 Z" fill="#A8D5BA" />

                <rect x="296" y="96" width="140" height="300" rx="16" fill="#1F7A5C" />
                <rect x="296" y="96" width="140" height="34" rx="16" fill="#FFFFFF" opacity="0.15" />
                <circle cx="312" cy="113" r="6" fill="#FFFFFF" opacity="0.7" />
                <circle cx="332" cy="113" r="6" fill="#FFFFFF" opacity="0.5" />
                <rect x="314" y="152" width="104" height="14" rx="7" fill="#FFFFFF" opacity="0.85" />
                <rect x="314" y="182" width="104" height="10" rx="5" fill="#FFFFFF" opacity="0.45" />
                <rect x="314" y="204" width="80" height="10" rx="5" fill="#FFFFFF" opacity="0.45" />
                <rect x="314" y="240" width="104" height="54" rx="12" fill="#FFFFFF" opacity="0.16" />
                <rect x="314" y="306" width="104" height="54" rx="12" fill="#FFFFFF" opacity="0.16" />

                <text x="366" y="432" textAnchor="middle" fontSize="20" fill="#1F7A5C" fontFamily="PingFang SC">客户案例库 H5</text>

                <circle cx="114" cy="440" r="16" fill="#E08A3C" />
                <text x="114" y="447" textAnchor="middle" fontSize="18" fontWeight="bold" fill="#FFFFFF" fontFamily="PingFang SC">A</text>
                <text x="150" y="447" fontSize="19" fill="#6B7C75" fontFamily="PingFang SC">只看本次相关的</text>
                <text x="114" y="486" textAnchor="middle" fontSize="19" fill="#6B7C75" fontFamily="PingFang SC">点 B 才跳出到完整案例库</text>
            </svg>
        </Box>
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <svg width="20" height="20" viewBox="0 0 24 24">
                <path d="M12 21C12 21 4 17 4 10C4 6 7 3 12 3C17 3 20 6 20 10C20 17 12 21 12 21Z" fill="#1F7A5C" opacity="0.75" />
