{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "pythonVersion": "3.11",
      "aptPkgs": ["ffmpeg"]
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyLimit": 3,
    "startCommand": "DATABASE_DIR=/data UPLOAD_DIR=/data/uploads TRUST_PROXY=true gunicorn app:app -b 0.0.0.0:$PORT -w 4",
    "volumeMounts": [
      {
        "name": "data",
        "mountPath": "/data"
      }
    ]
  }
}
