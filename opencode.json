{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ai-customer-service": {
      "type": "remote",
      "url": "{env:MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:MCP_TOKEN}"
      },
      "enabled": true
    },
    "ai-customer-service-local": {
      "type": "local",
      "command": ["python3", "scripts/mcp_server.py"],
      "enabled": false
    }
  }
}
