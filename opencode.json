{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ai-customer-service": {
      "type": "remote",
      "url": "https://aibao.jzzbaizhushou.com/api/mcp",
      "headers": {
        "Authorization": "Bearer {file:./.mcp_token}"
      },
      "enabled": true
    },
    "ai-customer-service-local": {
      "type": "local",
      "command": ["python3", "scripts/mcp_server.py"],
      "enabled": false
    }
  }
}
