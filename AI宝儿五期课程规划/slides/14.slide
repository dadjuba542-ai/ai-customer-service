<Slide style={{
    background: '#F7FAF6',
    paddingTop: 20, paddingBottom: 20, paddingLeft: 72, paddingRight: 72,
}}>
    <Box style={{ height: 100, justifyContent: 'center' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E3A32' }}>回答之后还能做什么</Text>
        <Box style={{ width: 56, height: 4, borderRadius: 2, background: '#1F7A5C', marginTop: 8 }} />
    </Box>

    <Box style={{ height: 528, flexDirection: 'row', gap: 28 }}>
        <Box style={{ width: 640 }}>
            <svg width="640" height="528" viewBox="0 0 640 528">
                <rect x="20" y="20" width="600" height="250" rx="18" fill="#FFFFFF" />
                <rect x="20" y="20" width="600" height="250" rx="18" fill="none" stroke="#DDE7E1" strokeWidth="2" />
                <circle cx="62" cy="62" r="22" fill="#1F7A5C" />
                <path d="M62 52 C52 54 50 62 50 62 C50 62 52 70 62 72 C72 70 74 62 74 62 C74 62 72 54 62 52 Z" fill="#FFFFFF" transform="translate(-12,-10) scale(0.9) translate(6,6)" />
                <text x="96" y="70" fontSize="22" fontWeight="bold" fill="#1E3A32" fontFamily="PingFang SC">AI宝儿</text>
                <rect x="44" y="104" width="420" height="14" rx="7" fill="#1F7A5C" opacity="0.55" />
                <rect x="44" y="134" width="540" height="12" rx="6" fill="#A8D5BA" opacity="0.7" />
                <rect x="44" y="160" width="500" height="12" rx="6" fill="#A8D5BA" opacity="0.7" />
                <rect x="44" y="186" width="360" height="12" rx="6" fill="#A8D5BA" opacity="0.7" />
                <rect x="44" y="222" width="560" height="30" rx="12" fill="rgba(31,122,92,0.08)" />

                <rect x="20" y="304" width="140" height="120" rx="16" fill="#1F7A5C" />
                <path d="M76 340 v-24 a10 10 0 0 1 20 0 v24 h8 a8 8 0 0 1 8 8 v26 a8 8 0 0 1 -8 8 h-36 a8 8 0 0 1 -8 -8 v-26 a8 8 0 0 1 8 -8 z" fill="#FFFFFF" />
                <text x="90" y="404" textAnchor="middle" fontSize="19" fill="#FFFFFF" fontFamily="PingFang SC">点赞点踩</text>

                <rect x="180" y="304" width="140" height="120" rx="16" fill="rgba(168,213,186,0.5)" />
                <rect x="228" y="328" width="44" height="36" rx="6" fill="none" stroke="#1E3A32" strokeWidth="4" />
                <path d="M228 356 l14 -14 l10 10 l12 -14 l8 8 v6 z" fill="#1E3A32" />
                <text x="250" y="404" textAnchor="middle" fontSize="19" fill="#1E3A32" fontFamily="PingFang SC">生成分享图</text>

                <rect x="340" y="304" width="140" height="120" rx="16" fill="rgba(168,213,186,0.5)" />
                <rect x="398" y="322" width="24" height="42" rx="12" fill="none" stroke="#1E3A32" strokeWidth="4" />
                <path d="M398 348 a12 12 0 0 0 24 0" fill="none" stroke="#1E3A32" strokeWidth="4" />
                <path d="M410 364 v10" stroke="#1E3A32" strokeWidth="4" strokeLinecap="round" />
                <text x="410" y="404" textAnchor="middle" fontSize="19" fill="#1E3A32" fontFamily="PingFang SC">语音输入</text>

                <rect x="500" y="304" width="140" height="120" rx="16" fill="#E08A3C" />
                <rect x="536" y="334" width="68" height="44" rx="8" fill="none" stroke="#FFFFFF" strokeWidth="4" />
                <path d="M536 338 l34 22 l34 -22" fill="none" stroke="#FFFFFF" strokeWidth="4" />
                <text x="570" y="404" textAnchor="middle" fontSize="19" fill="#FFFFFF" fontFamily="PingFang SC">获取方案</text>

                <text x="320" y="476" textAnchor="middle" fontSize="20" fill="#6B7C75" fontFamily="PingFang SC">每一条回答的操作区里，都藏着这四个按钮</text>
            </svg>
        </Box>

        <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1F7A5C', lineHeight: 1.45 }}>
                回答不是终点，<br />后面还有四步
            </Text>

            <Box style={{ marginTop: 22, gap: 16 }}>
                <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                    <FAIcon name='thumbs-up' style={{ fill: '#1F7A5C', width: 26, height: 26 }} />
                    <Text style={{ fontSize: 19, color: '#1E3A32', lineHeight: 1.55, flex: 1 }}>
                        <span style={{ fontWeight: 'bold' }}>点赞点踩</span>：顺手点一下，系统才知道哪类回答有用。点踩时写一句原因，比点十个赞都值钱。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                    <FAIcon name='image' style={{ fill: '#1F7A5C', width: 26, height: 26 }} />
                    <Text style={{ fontSize: 19, color: '#1E3A32', lineHeight: 1.55, flex: 1 }}>
                        <span style={{ fontWeight: 'bold' }}>生成分享图</span>：把一次问答变成一张竖版图片，直接发给客户，不用再手打一遍。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                    <FAIcon name='microphone' style={{ fill: '#1F7A5C', width: 26, height: 26 }} />
                    <Text style={{ fontSize: 19, color: '#1E3A32', lineHeight: 1.55, flex: 1 }}>
                        <span style={{ fontWeight: 'bold' }}>语音输入</span>：按住麦克风说话自动变文字，先落在输入框里，确认没错再发送。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                    <FAIcon name='envelope' style={{ fill: '#1F7A5C', width: 26, height: 26 }} />
                    <Text style={{ fontSize: 19, color: '#1E3A32', lineHeight: 1.55, flex: 1 }}>
                        <span style={{ fontWeight: 'bold' }}>获取方案</span>：需要跟进时留下联系方式和客户诉求，方便后续有人对接。
                    </Text>
                </Box>
            </Box>

            <Box style={{
                marginTop: 'auto', background: 'rgba(224,138,60,0.14)', borderRadius: 14, padding: 18,
            }}>
                <Text style={{ fontSize: 20, color: '#C9742B', fontWeight: 'bold', lineHeight: 1.5 }}>
                    把 AI 变成业绩的，往往不是提问那一下，而是回答之后的这一步。
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <svg width="20" height="20" viewBox="0 0 24 24">
                <path d="M12 21C12 21 4 17 4 10C4 6 7 3 12 3C17 3 20 6 20 10C20 17 12 21 12 21Z" fill="#1F7A5C" opacity="0.75" />
                <path d="M12 21V6" stroke="#FFFFFF" strokeWidth="1.6" fill="none" />
            </svg>
            <Text style={{ fontSize: 14, color: '#6B7C75' }}>AI宝儿 · 五期上手课</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#6B7C75' }}>14 / 33</Text>
    </Box>
</Slide>
